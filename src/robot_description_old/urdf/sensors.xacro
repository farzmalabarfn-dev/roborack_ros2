<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sensors">

    <!-- ================= -->
    <!-- CAMERA MOUNT -->
    <!-- ================= -->

    <link name="camera_mount">

      <visual>
        <geometry>
          <box size="0.05 0.05 0.25"/>
        </geometry>

        <material name="grey">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.05 0.05 0.25"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.2"/>

        <inertia
          ixx="0.001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.001"
          iyz="0.0"
          izz="0.001"/>
      </inertial>

    </link>


    <!-- ================= -->
    <!-- CAMERA -->
    <!-- ================= -->

    <link name="camera_link">

      <visual>
        <geometry>
          <box size="0.08 0.08 0.05"/>
        </geometry>

        <material name="blue">
          <color rgba="0 0 1 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.08 0.08 0.05"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.1"/>

        <inertia
          ixx="0.0002"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0002"
          iyz="0.0"
          izz="0.0002"/>
      </inertial>

    </link>


    <!-- ================= -->
    <!-- LIDAR -->
    <!-- ================= -->

    <link name="lidar_link">

      <visual>
        <geometry>
          <cylinder radius="0.06" length="0.04"/>
        </geometry>

        <material name="orange">
          <color rgba="1 0.5 0 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.06" length="0.04"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.15"/>

        <inertia
          ixx="0.0003"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0003"
          iyz="0.0"
          izz="0.0003"/>
      </inertial>

    </link>


    <!-- ================= -->
    <!-- JOINTS -->
    <!-- ================= -->

    <joint name="camera_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_mount"/>
      <origin xyz="0 0 0.25"/>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent link="camera_mount"/>
      <child link="camera_link"/>
      <origin xyz="0 0 0.15"/>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent link="camera_mount"/>
      <child link="lidar_link"/>
      <origin xyz="0 0 0.30"/>
    </joint>

  </xacro:macro>

</robot>