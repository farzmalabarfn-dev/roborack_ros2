<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="base">

    <link name="base_link">

      <visual>
        <geometry>
          <box size="0.5 0.3 0.2"/>
        </geometry>

        <material name="green">
          <color rgba="0 1 0 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.5 0.3 0.2"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="10.0"/>

        <origin xyz="0 0 0"/>

        <inertia
          ixx="0.15"
          iyy="0.25"
          izz="0.30"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>

    </link>

  </xacro:macro>

</robot>